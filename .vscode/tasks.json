{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile",
            "type": "shell",
            "command": "javac",
            "args": [
                "--module-path", "lib",
                "--add-modules", "javafx.controls,javafx.fxml",
                "-d", "bin",
                "-cp", "bin",
                "src/hms/*.java",
                "src/hms/model/*.java",
                "src/hms/repository/*.java",
                "src/hms/storage/*.java",
                "src/hms/billing/*.java",
                "src/hms/ui/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "java",
            "args": [
                "--module-path", "lib",
                "--add-modules", "javafx.controls,javafx.fxml",
                "-cp", "bin",
                "hms.AppLauncher"
            ],
            "dependsOn": "Compile",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
